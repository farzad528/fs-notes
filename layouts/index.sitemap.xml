{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.Home.Permalink }}</loc></url>
  {{ with site.GetPage "about" }}<url><loc>{{ .Permalink }}</loc></url>{{ end }}
  {{ with site.GetPage "archive" }}<url><loc>{{ .Permalink }}</loc></url>{{ end }}
  {{ range partial "publications.html" . }}
  <url><loc>{{ .Permalink }}</loc><lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod></url>
  {{ end }}
</urlset>
